    "dbgrp": {
        "prefix": "dbgrp",
        "body": [
            "qry = f\"\"\"",
            "select",
            "    $1,",
            "    $2,",
            "    count(1) as n",
            "from $3",
            "where $4 = '$5'",
            "group by 1,2",
            "order by 1,2",
            "\"\"\"",
            "df = eng.run(qry)",
            "df",
        ],
    },
    "dbctbl": {
        "prefix": "dbctbl",
        "body": [
            "tbl = \"$1\"",
            "",
            "try:",
            "    eng.run(f\"drop table {tbl}\")",
            "except Exception as e:",
            "    pass",
            "",
