{
    "xlsetup": {
        "prefix": "xlsetup",
        "body": [
            "import xlwings as xw",
        ],
    },
    "xlview": {
        "prefix": "xlview",
        "body": [
            "import xlwings as xw",
            "xw.view($1)",
        ],
    },
    "xlbook": {
        "prefix": "xlbook",
        "body": [
            "import xlwings as xw",
            "xw.Book()",
        ],
    },
    "xlsht": {
        "prefix": "xlsht",
        "body": [
            "import xlwings as xw",
            "ws = xw.sheets.active",
            "# ws = xw.Book().sheets['Sheet1']",
            "ws.name = \"$1\"",
        ],
    },
    "xlread": {
        "prefix": "xlread",
        "body": [
            "import xlwings as xw",
            "df2 = xw.sheets.active['$2'].expand().options(pd.DataFrame).value.reset_index()",
            "df2",
        ],
    },
    "xlwritenewsht": {
        "prefix": "xlwritenewsht",
        "body": [
            "import xlwings as xw",
            "ws = xw.books.active.sheets.add('$1')",
            "ws[\"A1\"].value = $1",
            "ws.tables.add(source=ws[\"A1\"].expand())",
        ],
    },
    "xlwrite0": {
        "prefix": "xlwrite0",
        "body": [
            "import xlwings as xw",
            "ws = xw.sheets.active",
            "ws[\"$2\"].value = $1",
            "ws.tables.add(source=ws[\"$2\"].expand())",
        ],
    },
    "xlwrite": {
        "prefix": "xlwrite",
        "body": [
            "ws = xw.sheets.active",
            "if ws[\"$2\"].value is not None:",
            "    ws[\"$2\"].expand().clear()",
            "ws[\"$2\"].value = $1",
            "ws.tables.add(source=ws[\"$2\"].expand())",
        ],
    },
    "xltext": {
        "prefix": "xltext",
        "body": [
            "ws = xw.sheets.active",
            "lines = $1.split(\"\\n\")",
            "if ws[\"$2\"].value is not None:",
            "    ws[\"$2\"].expand().clear()",
            "ws[\"$2\"].value = [[line or \" \"] for line in lines]",
        ],
    },
    "xlpivot": {
        "prefix": "xlpivot",
        "body": [
            "ws = xw.sheets.active",
            "pivot_cache = ws.book.api.PivotCaches().Create(",
            "    SourceType=1,  # xlDatabase",
            "    SourceData=\"$1\",",
            ")",
            "pt = pivot_cache.CreatePivotTable(",
            "    TableDestination=ws[\"$2\"].api,",
            "    TableName=\"Pivot$3\",",
            ")",
            "pt.PivotFields(\"$4\").Orientation = 3  # xlPageField (Filter)",
            "pt.PivotFields(\"$5\").Orientation = 1  # xlRowField",
            "pt.PivotFields(\"$6\").Orientation = 2  # xlColumnField",
            "pt.AddDataField(",
            "    pt.PivotFields(\"$7\"), \"Sum $7\", -4157 # xlSum",
            ")",
            "pt.AddDataField(",
            "    pt.PivotFields(\"$7\"), \"Average $7\", -4106 # xlAverage",
            ")",
        ],
    },
    "xlchart": {
        "prefix": "xlchart",
        "body": [
            "ws = xw.sheets.active",
            "chart = ws.charts.add(",
            "    top=ws['$1'].top, left=ws['$1'].left, width=500, height=300,",
            ")",
            "chart.chart_type = '${2:area_stacked}'",
            "chart.set_source_data(ws['$3'].expand())",
            "",
            "chart_com = chart.api[1]  # (Shape, Chart) tuple on Windows",
            "chart_com.HasTitle = True",
            "chart_com.ChartTitle.Text = \"$4\"",
        ],
    },
    "xlslicer": {
        "prefix": "xlslicer",
        "body": [
            "ws = xw.sheets.active",
            "pt_com = ws.api.PivotTables(\"$1\")",
            "sc = ws.book.api.SlicerCaches.Add2(",
            "    Source=pt_com,",
            "    SourceField=\"$2\",",
            ")",
            "slicer = sc.Slicers.Add(",
            "    SlicerDestination=ws.api,",
            "    Width=100,",
            "    Height=200,",
            ")",
            "slicer.Top = ${3:200}",
            "slicer.Left = ${4:200}",
        ],
    },
    "xlpivdash": {
        "prefix": "xlpivdash",
        "body": [
            "import xlwings as xw",
            "wb = xw.Book()",
            "dashboard = PivotDashboard(wb)",
            "dashboard.write_table(df, code=$1)",
            "",
            "pivot_configs = [",
            "    # fmt: off",
            "    dict(data_field=\"n\",row_field=$2,col_field=$3,chart_type=\"area_stacked\",),",
            "    # fmt: on",
            "]",
            "dashboard.add_pivots(pivot_configs)",
            "",
            "dashboard.add_slicers(",
            "    fields=[",
            "        $2,",
            "        $3,",
            "    ],",
            ")",
        ],
    },
    "xlwipe": {
        "prefix": "xlwipe",
        "body": [
            "ws = xw.sheets.active",
            "pt_com = ws.api.PivotTables(\"$1\")",
            "pt_com.TableRange2.Clear()",
            "",
            "chart.delete()",
            "sc.Delete()",
        ],
    }
}