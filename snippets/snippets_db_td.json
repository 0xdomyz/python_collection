{
    "tdsetup": {
        "prefix": "tdsetup",
        "body": [
            "import sqlalchemy as alc",
            "import pandas as pd",
            "import os",
            "",
            "# add run method to engine",
            "def run(self: alc.engine.Engine, sql:str) -> pd.DataFrame | None:",
            "    with self.begin() as conn:",
            "        res = conn.execute(alc.text(sql))",
            "        if res.returns_rows:",
            "            return pd.DataFrame(res.all(), columns=res.keys())",
            "",
            "alc.engine.Engine.run = run",
            "",
            "connection_string = f\"teradatasql://$1:{os.environ['password']}@$2\"",
            "eng = alc.create_engine(connection_string)",
        ],
    },
    "dbtdinfo": {
        "prefix": "dbtdinfo",
        "body": [
            "qry = f\"\"\"",
            "SELECT ",
            "    t.DatabaseName as table_schema,",
            "    t.TableName as table_name,",
            "    c.ColumnId as column_position,",
            "    c.ColumnName as column_name,",
            "    c.ColumnType as data_type,",
            "    c.ColumnLength as column_length,",
            "    c.DecimalTotalDigits as precision_digits,",
            "    c.DecimalFractionalDigits as scale_digits,",
            "    c.Nullable as is_nullable",
            "FROM DBC.TablesV t",
            "LEFT JOIN DBC.ColumnsV c ON t.DatabaseName = c.DatabaseName AND t.TableName = c.TableName",
            "WHERE ",
            "    t.DatabaseName = '${1:your_database_name}'",
            "    AND t.TableName = '${2:your_table_name}'",
            "ORDER BY c.ColumnId;",
            "\"\"\"",
            "df = eng.run(qry)",
            "df",
        ],
    },
}