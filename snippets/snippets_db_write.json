{
    "dbdrop": {
        "prefix": "dbdrop",
        "body": [
            "try:",
            "    eng.run(f\"drop table $1\")",
            "except Exception as e:",
            "    pass",
        ],
    },
    "dbctbl": {
        "prefix": "dbctbl",
        "body": [
            "tbl = \"$1\"",
            "",
            "try:",
            "    eng.run(f\"drop table {tbl}\")",
            "except Exception as e:",
            "    pass",
            "",
            "qry = f\"\"\"",
            "create table {tbl} as (",
            "    select *",
            "    from $2",
            ") with data;",
            "\"\"\"",
            "",
            "_ = eng.run(qry)",
            "_ = eng.run(f\"select count(*) from {tbl}\").iloc[0, 0]",
            "print(_)",
        ],
    },
    "dbwrite": {
        "prefix": "dbwrite",
        "body": [
            "tbl = \"$1\"",
            "",
            "try:",
            "    eng.run(f\"drop table {tbl}\")",
            "except Exception as e:",
            "    pass",
            "",
            "qry = f\"\"\"",
            "create table {tbl}(",
            "    survived INT,",
            "    sex VARCHAR(10),",
            "    age FLOAT,",
            "    adult_male BYTEINT",
            ");",
            "\"\"\"",
            "_ = eng.run(qry)",
            "",
            "sch, tbl2 = tbl.split('.')",
            "df.to_sql(tbl2, eng, if_exists='append', index=False, schema=sch)",
            "eng.run(f\"select count(*) from {tbl}\").iloc[0, 0]",
        ],
    }
}
